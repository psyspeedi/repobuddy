# =============================================================================
# RepoBuddy — environment template
#
# Copy to `.env` and fill in. Every variable that the app reads is listed
# below — even ones with sensible defaults in code — so you can see the
# whole surface without grepping the source.
#
# Legend:
#   REQUIRED        — server refuses to boot without it.
#   default: X      — value used when the line is blank or absent.
#   read directly   — not in env.ts schema, read via process.env at call site.
# =============================================================================

# -----------------------------------------------------------------------------
# Database / Redis (REQUIRED)
# -----------------------------------------------------------------------------
# Docker-compose pulls the four POSTGRES_* values from here; the app only
# reads DATABASE_URL. Keep them consistent.
POSTGRES_USER=repobuddy
POSTGRES_PASSWORD=repobuddy
POSTGRES_DB=repobuddy
POSTGRES_PORT=5532
DATABASE_URL=postgres://repobuddy:repobuddy@localhost:5532/repobuddy

REDIS_PORT=6479
REDIS_URL=redis://localhost:6479

# -----------------------------------------------------------------------------
# LLM providers — at least one of OPENAI_API_KEY or LLM_API_KEY is REQUIRED.
#
# Resolution order at call time (server/providers/{llm,embeddings}.ts):
#   LLM_*       → unified OpenAI-compatible config (Groq, OpenRouter, Together,
#                 Ollama, vLLM, …). Used when set.
#   OPENAI_*    → legacy fallback. Used when LLM_* not set.
#
# Embeddings resolve separately so you can split chat vs. embeddings:
#   EMBEDDING_* → if set
#   LLM_*       → if set
#   OPENAI_*    → final fallback
# -----------------------------------------------------------------------------

# OpenAI (legacy single-vendor path). Blank if you use LLM_* below.
OPENAI_API_KEY=
# default: gpt-4o-mini
OPENAI_MODEL_EXTRACTION=gpt-4o-mini
# default: gpt-4o
OPENAI_MODEL_PLANNING=gpt-4o
# default: text-embedding-3-small
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Unified OpenAI-compatible LLM endpoint. Examples:
#   Groq:        https://api.groq.com/openai/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Together:    https://api.together.xyz/v1
#   Ollama:      http://localhost:11434/v1
#   vLLM:        http://your-host:8000/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_PLANNING=
LLM_MODEL_EXTRACTION=

# Separate endpoint for embeddings (most non-OpenAI providers don't have
# them — point this at OpenAI while LLM_* points at Groq, etc).
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# -----------------------------------------------------------------------------
# GitHub OAuth (REQUIRED)
# https://github.com/settings/developers → New OAuth App
# Authorization callback URL: {API_URL}/auth/github/callback
#   dev:  http://localhost:3001/auth/github/callback
#   prod: https://<your-domain>/auth/github/callback
# It points at the API, not the frontend — /auth/github* is deliberately kept
# outside the /api prefix so this URL stays stable.
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public origin of the API, used ONLY to build the OAuth callback URL
# (passport). Behind Caddy the API shares the site's domain, so set this
# to the same value as APP_URL there. Must match the callback registered
# on the GitHub OAuth App above, or sign-in fails.
#   dev:  http://localhost:3001   prod: https://<your-domain>
# default (read directly via process.env): http://localhost:3001
API_URL=http://localhost:3001

# Optional: personal access token for GitHub API reads (issues, PRs,
# find_resolution, PR-history indexing). Raises the API rate limit from
# 60 req/h (anonymous, per IP) to 5000 req/h. Read-only public scope
# is enough.
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# Secrets (REQUIRED)
# -----------------------------------------------------------------------------
# Sealed-cookie session secret (>=32 chars).
# Generate: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# AES-GCM key for at-rest secrets in DB (GitHub refresh tokens, BYOK API keys).
# MUST be 32 bytes encoded as 64 hex chars.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# In production set this to your own public URL (e.g. https://<your-domain>)
# — canonical, sitemap, JSON-LD all derive from it. There is no hosted
# RepoBuddy instance; this is whatever domain you deploy to.
# default: http://localhost:3000
APP_URL=http://localhost:3000
# default: localhost
APP_DOMAIN=localhost
# Log label only: 'web' for the HTTP API process, 'worker' for the BullMQ
# background process. Set per-container in docker-compose.prod.yml.
# default: web
PROCESS_ROLE=web

# Origin the Nuxt frontend calls for the API, exposed as runtimeConfig.public
# .apiBaseUrl (apps/web/nuxt.config.ts). Also the base of the /badge/*.svg URL
# in the README snippet. Behind Caddy set this to the same origin as APP_URL.
# default: http://localhost:3001
API_BASE_URL=http://localhost:3001

# Browser origin(s) allowed to call the API with credentials, comma-separated.
# Read directly via process.env (main.ts, mcp.service.ts) — not in env.ts.
# Needed in dev because Nuxt (:3000) and the API (:3001) are separate origins;
# behind Caddy in production everything is one origin and this can stay unset.
# default: http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# How many reverse-proxy hops to trust for the client IP (Express
# `trust proxy`). Every per-IP rate limit — MCP, badge, chat, freshness —
# keys off the result, so this must be 0 whenever the API is reachable
# directly: with a hop trusted and no proxy in front, a client can put any
# address it likes in X-Forwarded-For and get a fresh bucket per request.
# docker-compose.prod.yml sets it to 1, where Caddy is the only entry point.
# default: 0
TRUST_PROXY_HOPS=0

# default: development
NODE_ENV=development

# Admins: comma-separated GitHub logins. These users bypass all quotas,
# can delete any workspace, and see admin-only controls in the UI.
# default: '' (no admins)
ADMIN_LOGINS=

# Bearer token protecting /api/metrics (Prometheus scrape).
# Unset ⇒ open in dev, 404 in production.
# Generate: openssl rand -hex 24
METRICS_TOKEN=

# Kill switch for the MCP endpoint (POST /api/mcp) that exposes the KAG
# operators to Claude Code / Cursor. Unauthenticated by design — it only
# ever reads workspaces marked public. Set to false or 0 to disable.
# default: true
MCP_ENABLED=true

# -----------------------------------------------------------------------------
# Indexing limits / budgets
# -----------------------------------------------------------------------------
# default: 200
MAX_REPO_SIZE_MB=200
# default: 2000
MAX_FILES_PER_INDEX=2000
# Hard USD cap per single index pipeline run.
# default: 2.0
LLM_BUDGET_USD_PER_INDEX=2.0

# -----------------------------------------------------------------------------
# Per-user daily quotas (admins + BYOK users bypass enforcement).
# Counters live in Redis with a 48h TTL, keyed by UTC day.
# -----------------------------------------------------------------------------
# default: 3
QUOTA_WORKSPACES_PER_DAY=3
# default: 50
QUOTA_MESSAGES_PER_DAY=50
# default: 200000
QUOTA_TOKENS_PER_DAY=200000

# Guest quotas: applied to anonymous visitors hitting a public workspace's
# chat. Identity is a httpOnly cookie 'repobuddy-guest' (uuid).
# default: 10
QUOTA_GUEST_MESSAGES_PER_DAY=10
# default: 40000
QUOTA_GUEST_TOKENS_PER_DAY=40000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Valid: fatal | error | warn | info | debug | trace
# default: info
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Observability — Sentry, Grafana, Telegram alerts
# -----------------------------------------------------------------------------
# Sentry DSN — leave blank to disable error reporting.
# Create at sentry.io → New project (Nuxt). 5K events/month free tier.
SENTRY_DSN=
# default: same as NODE_ENV when blank
SENTRY_ENVIRONMENT=
# Fraction (0..1) of transactions to send. default: 0.1
SENTRY_TRACES_SAMPLE_RATE=0.1

# Telegram bot for budget / error alerts. Create via @BotFather → /newbot.
# chat_id: write to your bot, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Global daily USD cap across ALL traffic. When reached, non-admin requests
# are blocked (503) and a Telegram alert fires. Alerts also fire at 80%.
# Set 0 to disable. default: 3
COST_BUDGET_USD_PER_DAY=3

# Grafana / Prometheus / Loki host ports (services live in docker-compose).
GRAFANA_PORT=3301
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# IndexNow key — used to ping Bing + Yandex when a public workspace
# appears or changes visibility. Generate with: openssl rand -hex 16
# Leave blank to disable. Verification file is served at
# https://<host>/indexnow/<KEY>.txt
# (under /indexnow/* so the dynamic route doesn't swallow /).
INDEXNOW_KEY=

# -----------------------------------------------------------------------------
# Worker tuning  (read directly via process.env — not in env.ts schema)
# -----------------------------------------------------------------------------
# Concurrent index jobs per worker process. default: 2
WORKER_CONCURRENCY=2
# Parallel LLM annotation requests during indexing. default: 8
ANNOTATION_CONCURRENCY=8

# -----------------------------------------------------------------------------
# Test / dev knobs  (read directly — do NOT set in production)
# -----------------------------------------------------------------------------
# When '1', createLLMProvider / createEmbeddingsProvider return a mock that
# yields canned responses — used by unit tests and offline dev sessions.
# This is the name the code and CI actually read (providers/internals/llm.ts,
# providers/internals/embeddings.ts, .github/workflows/ci.yml).
# default: unset
CODEGRAPH_MOCK_PROVIDERS=

# Postgres connection used by the integration suite. The helper refuses any
# database whose name doesn't end in _test, so with a dev DATABASE_URL
# exported (the usual case) the suite will NOT run until you set this:
#   createdb repobuddy_test  # once
#   TEST_DATABASE_URL=postgres://repobuddy:repobuddy@localhost:5532/repobuddy_test pnpm db:migrate
# Only when DATABASE_URL is unset does it fall back to .../repobuddy_test.
# default: unset
TEST_DATABASE_URL=
