# Database
POSTGRES_USER=codegraph
POSTGRES_PASSWORD=codegraph
POSTGRES_DB=codegraph
POSTGRES_PORT=5432
DATABASE_URL=postgres://codegraph:codegraph@localhost:5432/codegraph

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL_EXTRACTION=gpt-4o-mini
OPENAI_MODEL_PLANNING=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate via: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# Encryption key for at-rest secrets in DB (32 bytes hex)
# Generate via: openssl rand -hex 32
ENCRYPTION_KEY=

# App
APP_URL=http://localhost:3000
APP_DOMAIN=codegraph.example.com
PROCESS_ROLE=web

# Limits / budgets
MAX_REPO_SIZE_MB=200
MAX_FILES_PER_INDEX=2000
LLM_BUDGET_USD_PER_INDEX=2.00

# Logging
LOG_LEVEL=info
