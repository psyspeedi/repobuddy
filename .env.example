# =============================================================================
# CodeGraph — environment template
#
# Copy to `.env` and fill in. Every variable that the app reads is listed
# below — even ones with sensible defaults in code — so you can see the
# whole surface without grepping the source.
#
# Legend:
#   REQUIRED        — server refuses to boot without it.
#   default: X      — value used when the line is blank or absent.
#   read directly   — not in env.ts schema, read via process.env at call site.
# =============================================================================

# -----------------------------------------------------------------------------
# Database / Redis (REQUIRED)
# -----------------------------------------------------------------------------
# Docker-compose pulls the four POSTGRES_* values from here; the app only
# reads DATABASE_URL. Keep them consistent.
POSTGRES_USER=codegraph
POSTGRES_PASSWORD=codegraph
POSTGRES_DB=codegraph
POSTGRES_PORT=5532
DATABASE_URL=postgres://codegraph:codegraph@localhost:5532/codegraph

REDIS_PORT=6479
REDIS_URL=redis://localhost:6479

# -----------------------------------------------------------------------------
# LLM providers — at least one of OPENAI_API_KEY or LLM_API_KEY is REQUIRED.
#
# Resolution order at call time (server/providers/{llm,embeddings}.ts):
#   LLM_*       → unified OpenAI-compatible config (Groq, OpenRouter, Together,
#                 Ollama, vLLM, …). Used when set.
#   OPENAI_*    → legacy fallback. Used when LLM_* not set.
#
# Embeddings resolve separately so you can split chat vs. embeddings:
#   EMBEDDING_* → if set
#   LLM_*       → if set
#   OPENAI_*    → final fallback
# -----------------------------------------------------------------------------

# OpenAI (legacy single-vendor path). Blank if you use LLM_* below.
OPENAI_API_KEY=
# default: gpt-4o-mini
OPENAI_MODEL_EXTRACTION=gpt-4o-mini
# default: gpt-4o
OPENAI_MODEL_PLANNING=gpt-4o
# default: text-embedding-3-small
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Unified OpenAI-compatible LLM endpoint. Examples:
#   Groq:        https://api.groq.com/openai/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Together:    https://api.together.xyz/v1
#   Ollama:      http://localhost:11434/v1
#   vLLM:        http://your-host:8000/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_PLANNING=
LLM_MODEL_EXTRACTION=

# Separate endpoint for embeddings (most non-OpenAI providers don't have
# them — point this at OpenAI while LLM_* points at Groq, etc).
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# -----------------------------------------------------------------------------
# GitHub OAuth (REQUIRED)
# https://github.com/settings/developers → New OAuth App
# Authorization callback URL: {APP_URL}/auth/github
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Secrets (REQUIRED)
# -----------------------------------------------------------------------------
# Sealed-cookie session secret (>=32 chars).
# Generate: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# AES-GCM key for at-rest secrets in DB (GitHub refresh tokens, BYOK API keys).
# MUST be 32 bytes encoded as 64 hex chars.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# In production set this to the public URL (e.g. https://repobuddy.space)
# — canonical, sitemap, JSON-LD all derive from it.
# default: http://localhost:3000
APP_URL=http://localhost:3000
# default: localhost
APP_DOMAIN=localhost
# 'web' for the Nuxt app, 'worker' for the BullMQ background process.
# default: web
PROCESS_ROLE=web
# default: development
NODE_ENV=development

# Admins: comma-separated GitHub logins. These users bypass all quotas,
# can delete any workspace, and see admin-only controls in the UI.
# default: '' (no admins)
ADMIN_LOGINS=

# -----------------------------------------------------------------------------
# Indexing limits / budgets
# -----------------------------------------------------------------------------
# default: 200
MAX_REPO_SIZE_MB=200
# default: 2000
MAX_FILES_PER_INDEX=2000
# Hard USD cap per single index pipeline run.
# default: 2.0
LLM_BUDGET_USD_PER_INDEX=2.0

# -----------------------------------------------------------------------------
# Per-user daily quotas (admins + BYOK users bypass enforcement).
# Counters live in Redis with a 48h TTL, keyed by UTC day.
# -----------------------------------------------------------------------------
# default: 3
QUOTA_WORKSPACES_PER_DAY=3
# default: 50
QUOTA_MESSAGES_PER_DAY=50
# default: 200000
QUOTA_TOKENS_PER_DAY=200000

# Guest quotas: applied to anonymous visitors hitting a public workspace's
# chat. Identity is a httpOnly cookie 'codegraph-guest' (uuid).
# default: 10
QUOTA_GUEST_MESSAGES_PER_DAY=10
# default: 40000
QUOTA_GUEST_TOKENS_PER_DAY=40000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Valid: fatal | error | warn | info | debug | trace
# default: info
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Observability — Sentry, Grafana, Telegram alerts
# -----------------------------------------------------------------------------
# Sentry DSN — leave blank to disable error reporting.
# Create at sentry.io → New project (Nuxt). 5K events/month free tier.
SENTRY_DSN=
# default: same as NODE_ENV when blank
SENTRY_ENVIRONMENT=
# Fraction (0..1) of transactions to send. default: 0.1
SENTRY_TRACES_SAMPLE_RATE=0.1

# Telegram bot for budget / error alerts. Create via @BotFather → /newbot.
# chat_id: write to your bot, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Global daily USD cap across ALL traffic. When reached, non-admin requests
# are blocked (503) and a Telegram alert fires. Alerts also fire at 80%.
# Set 0 to disable. default: 3
COST_BUDGET_USD_PER_DAY=3

# Grafana / Prometheus / Loki host ports (services live in docker-compose).
GRAFANA_PORT=3301
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# Worker tuning  (read directly via process.env — not in env.ts schema)
# -----------------------------------------------------------------------------
# Concurrent index jobs per worker process. default: 2
WORKER_CONCURRENCY=2
# Parallel LLM annotation requests during indexing. default: 8
ANNOTATION_CONCURRENCY=8

# -----------------------------------------------------------------------------
# Test / dev knobs  (read directly — do NOT set in production)
# -----------------------------------------------------------------------------
# When '1', createLLMProvider / createEmbeddingsProvider return a mock that
# yields canned responses — used by unit tests and offline dev sessions.
# default: unset
CODEGRAPH_MOCK_PROVIDERS=
