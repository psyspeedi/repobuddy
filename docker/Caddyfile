# www отправляем на канонический адрес. Без этого блока Caddy не знает
# такого хоста: сертификата на www нет, и соединение рвётся на рукопожатии —
# для посетителя выглядит как лежащий сайт, хотя DNS-запись ведёт куда надо.
#
# Каноническим везде считается APP_DOMAIN без www: он в og-тегах, в sitemap
# и в canonical-ссылках. 301 закрепляет это для поисковиков и не даёт
# развестись двум версиям одной страницы.
#
# Отдельный блок, а не второй адрес у основного: иначе www отвечал бы
# содержимым, а не редиректом, и обе версии остались бы живыми.
www.{$APP_DOMAIN} {
    redir https://{$APP_DOMAIN}{uri} permanent
}

{$APP_DOMAIN} {
    encode gzip zstd

    # Same-origin layout: browser talks to one domain, Caddy splits
    # traffic between the Nuxt SSR server (web:3000) and the NestJS API
    # (api:3001). Set NUXT_PUBLIC_API_BASE_URL / API_URL / APP_URL to the
    # same https://{$APP_DOMAIN} — no CORS, one session cookie.
    #
    # API-owned paths outside the /api prefix:
    #   /auth/github*  — OAuth start + callback (stable URL for the GitHub app)
    #   robots/sitemap/feed/indexnow — SEO routes served at canonical paths
    #   /badge/*       — README badge SVGs (short URL maintainers paste)
    @api path /api/* /auth/github* /robots.txt /sitemap.xml /feed.xml /indexnow/* /badge/*

    # flush_interval -1 disables buffering so the two SSE streams
    # (chat, index progress) deliver events as they happen.
    reverse_proxy @api api:3001 {
        flush_interval -1
    }

    reverse_proxy web:3000
}
