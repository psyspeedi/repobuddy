{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": "./",
    "types": ["node"],
    "paths": {
      "#shared/*": ["../../packages/shared/src/*"],
      "#server/db/*": ["./src/db/*"],
      "#server/lib/*": ["./src/lib/*"],
      "#server/kag/*": ["./src/modules/kag/internals/*"],
      "#server/indexer/*": ["./src/modules/indexer/internals/*"],
      "#server/providers/*": ["./src/modules/providers/internals/*"]
    },
    "allowImportingTsExtensions": false,
    "noEmit": true
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*", "*.config.ts"]
}
