{
  "name": "@repobuddy/api",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#shared/*": "../../packages/shared/src/*",
    "#server/db/*": "./src/db/*",
    "#server/lib/*": "./src/lib/*",
    "#server/kag/*": "./src/modules/kag/internals/*",
    "#server/indexer/*": "./src/modules/indexer/internals/*",
    "#server/providers/*": "./src/modules/providers/internals/*",
    "#modules/*": "./src/modules/*",
    "#common/*": "./src/common/*"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "start:dev:worker": "tsx watch src/main.worker.ts",
    "start": "node dist/src/main.js",
    "start:worker": "node dist/src/main.worker.js",
    "build": "nest build && node -e \"require('fs').writeFileSync('dist/package.json', JSON.stringify({type:'commonjs'}))\"",
    "build:check-paths": "echo '\\nNOTE: nest build with swc emits #shared/#server aliases as relative paths against src/, which break after the move to dist/. Production runtime currently uses tsx (see apps/api/Dockerfile). Switch this build script to use tsc-alias or migrate to fully-relative imports to enable node dist/src/main.js.\\n'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'api: lint TBD'",
    "lint:fix": "echo 'api: lint TBD'",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:test": "DATABASE_URL=postgres://repobuddy:repobuddy@localhost:5532/repobuddy_test tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "backfill:insights": "tsx scripts/backfill-git-insights.ts",
    "backfill:cost": "tsx scripts/backfill-cost-log.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.4.13",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.4.13",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.13",
    "@nestjs/terminus": "^11.1.1",
    "@octokit/rest": "^22.0.1",
    "@repobuddy/shared": "workspace:*",
    "@sentry/nestjs": "^10.56.0",
    "@sentry/node": "^10.53.1",
    "bullmq": "^5.76.8",
    "cheerio": "^1.2.0",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express-session": "^1.19.0",
    "gpt-tokenizer": "^3.4.0",
    "ignore": "^7.0.5",
    "ioredis": "^5.10.1",
    "nestjs-pino": "^4.6.1",
    "openai": "^6.38.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "redis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "simple-git": "^3.36.0",
    "tree-sitter-wasms": "0.1.13",
    "ts-morph": "^28.0.0",
    "uncrypto": "^0.1.3",
    "unzipper": "^0.12.3",
    "web-tree-sitter": "0.20.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.22",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.40",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.10.5",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/pg": "^8.20.0",
    "@types/unzipper": "^0.10.11",
    "@vitest/ui": "^2.1.8",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
