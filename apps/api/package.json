{
  "name": "@repobuddy/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#shared/*": "../../packages/shared/src/*",
    "#server/*": "./src/legacy/*"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "start:dev:worker": "tsx watch src/main.worker.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/main.worker.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'api: lint TBD'",
    "lint:fix": "echo 'api: lint TBD'",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/legacy/db/migrate.ts",
    "db:migrate:test": "DATABASE_URL=postgres://repobuddy:repobuddy@localhost:5532/repobuddy_test tsx src/legacy/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "backfill:insights": "tsx scripts/backfill-git-insights.ts",
    "backfill:cost": "tsx scripts/backfill-cost-log.ts",
    "build:worker": "tsx src/legacy/workers/build.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.13",
    "@nestjs/core": "^10.4.13",
    "@nestjs/platform-express": "^10.4.13",
    "@octokit/rest": "^22.0.1",
    "@repobuddy/shared": "workspace:*",
    "@sentry/node": "^10.53.1",
    "bullmq": "^5.76.8",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "gpt-tokenizer": "^3.4.0",
    "ignore": "^7.0.5",
    "ioredis": "^5.10.1",
    "openai": "^6.38.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "simple-git": "^3.36.0",
    "tree-sitter-wasms": "0.1.13",
    "ts-morph": "^28.0.0",
    "uncrypto": "^0.1.3",
    "unzipper": "^0.12.3",
    "web-tree-sitter": "0.20.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.20.0",
    "@types/unzipper": "^0.10.11",
    "@vitest/ui": "^2.1.8",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
