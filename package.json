{
  "name": "repobuddy",
  "version": "0.0.1",
  "description": "RepoBuddy — AI assistant for understanding codebases via knowledge graphs (KAG)",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "imports": {
    "#shared/*": "./shared/*"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:web": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres redis",
    "db:logs": "docker compose logs -f postgres",
    "db:psql": "docker compose exec postgres psql -U repobuddy -d repobuddy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:migrate:test": "DATABASE_URL=postgres://repobuddy:repobuddy@localhost:5532/repobuddy_test tsx server/db/migrate.ts",
    "db:create:test": "docker compose exec postgres psql -U repobuddy -d postgres -c 'CREATE DATABASE repobuddy_test;' && pnpm db:migrate:test",
    "db:studio": "drizzle-kit studio",
    "dev:worker": "tsx watch server/workers/index.ts",
    "build:worker": "tsx server/workers/build.ts",
    "backfill:insights": "tsx scripts/backfill-git-insights.ts",
    "backfill:cost": "tsx scripts/backfill-cost-log.ts"
  },
  "dependencies": {
    "@nuxtjs/color-mode": "^3.5.2",
    "@nuxtjs/i18n": "^10.3.0",
    "@octokit/rest": "^22.0.1",
    "@sentry/node": "^10.53.1",
    "@sentry/nuxt": "^10.53.1",
    "@types/dompurify": "^3.2.0",
    "@vueuse/core": "^12.4.0",
    "@vueuse/nuxt": "^12.4.0",
    "bullmq": "^5.76.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-hierarchy": "^3.1.2",
    "d3-scale-chromatic": "^3.1.0",
    "dompurify": "^3.4.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "gpt-tokenizer": "^3.4.0",
    "graphology": "^0.26.0",
    "graphology-layout": "^0.6.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-types": "^0.24.8",
    "ignore": "^7.0.5",
    "ioredis": "^5.10.1",
    "isomorphic-dompurify": "^3.13.0",
    "lucide-vue-next": "^0.469.0",
    "marked": "^18.0.3",
    "mermaid": "^11.15.0",
    "nuxt": "^4.1.3",
    "nuxt-auth-utils": "^0.5.29",
    "openai": "^6.38.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "reka-ui": "^2.0.0",
    "shadcn-nuxt": "^1.0.3",
    "shiki": "^4.0.2",
    "sigma": "^3.0.3",
    "simple-git": "^3.36.0",
    "tailwind-merge": "^2.6.0",
    "tree-sitter-wasms": "0.1.13",
    "ts-morph": "^28.0.0",
    "uncrypto": "^0.1.3",
    "unzipper": "^0.12.3",
    "vue": "^3.5.13",
    "vue-router": "^5.0.7",
    "web-tree-sitter": "0.20.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.7.4",
    "@tailwindcss/vite": "^4.0.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.20.0",
    "@types/unzipper": "^0.10.11",
    "@vitest/ui": "^2.1.8",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "eslint": "^9.18.0",
    "happy-dom": "^16.5.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vue-tsc": "^3.2.9"
  }
}