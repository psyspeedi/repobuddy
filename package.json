{
  "name": "codegraph",
  "version": "0.0.1",
  "description": "AI assistant for understanding codebases via knowledge graphs (KAG)",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:web": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres redis",
    "db:logs": "docker compose logs -f postgres",
    "db:psql": "docker compose exec postgres psql -U codegraph -d codegraph",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "dev:worker": "tsx watch server/workers/index.ts",
    "build:worker": "tsx server/workers/build.ts"
  },
  "dependencies": {
    "@nuxtjs/color-mode": "^3.5.2",
    "@vueuse/core": "^12.4.0",
    "@vueuse/nuxt": "^12.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-vue-next": "^0.469.0",
    "nuxt": "^4.1.3",
    "nuxt-auth-utils": "^0.5.29",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "reka-ui": "^2.0.0",
    "shadcn-nuxt": "^1.0.3",
    "tailwind-merge": "^2.6.0",
    "vue": "^3.5.13",
    "vue-router": "^5.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.7.4",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.20.0",
    "@vitest/ui": "^2.1.8",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "happy-dom": "^16.5.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vue-tsc": "^3.2.9"
  }
}
