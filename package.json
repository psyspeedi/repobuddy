{
  "name": "repobuddy",
  "version": "0.0.1",
  "description": "RepoBuddy — AI assistant for understanding codebases via knowledge graphs (KAG)",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:web": "pnpm --filter @repobuddy/web dev",
    "dev:api": "pnpm --filter @repobuddy/api start:dev",
    "dev:worker": "pnpm --filter @repobuddy/api start:dev:worker",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres redis",
    "db:logs": "docker compose logs -f postgres",
    "db:psql": "docker compose exec postgres psql -U repobuddy -d repobuddy",
    "db:generate": "pnpm --filter @repobuddy/api db:generate",
    "db:migrate": "pnpm --filter @repobuddy/api db:migrate",
    "db:migrate:test": "pnpm --filter @repobuddy/api db:migrate:test",
    "db:studio": "pnpm --filter @repobuddy/api db:studio"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
