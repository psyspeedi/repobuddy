{
  "title": "RepoBuddy — KAG performance",
  "uid": "repobuddy-performance",
  "schemaVersion": 39,
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "tags": ["repobuddy", "performance"],
  "panels": [
    {
      "id": 1,
      "title": "Operator invocations / 5m",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (op) (rate(repobuddy_kag_operator_runs_total[5m]))",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Operator failure rate / 5m",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (op) (rate(repobuddy_kag_operator_runs_total{outcome=\"error\"}[5m]))",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } }
    },
    {
      "id": 3,
      "title": "Operator p95 latency (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (op, le) (rate(repobuddy_kag_operator_latency_seconds_bucket[5m])))",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Operator p50 latency (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (op, le) (rate(repobuddy_kag_operator_latency_seconds_bucket[5m])))",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Top-N slowest operators (1h avg)",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "sort_desc(sum by (op) (rate(repobuddy_kag_operator_latency_seconds_sum[1h])) / sum by (op) (rate(repobuddy_kag_operator_latency_seconds_count[1h])))",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6,
      "title": "Planner fallbacks vs. successes",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "sum(rate(repobuddy_planner_failures_total[5m]))",
          "legendFormat": "planner fallback",
          "refId": "A"
        },
        {
          "expr": "sum(rate(repobuddy_chat_requests_total{status=\"ok\"}[5m]))",
          "legendFormat": "chat ok",
          "refId": "B"
        }
      ]
    }
  ]
}
